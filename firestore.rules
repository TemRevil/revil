rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Function to check if the user is the admin (uses Firebase Custom Claims)
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Allow public read access to core portfolio data.
    // The Views map stays publicly READABLE (the project modal shows those counts)
    // but is no longer publicly writable: the trackSession Cloud Function raises it
    // from the visit it just recorded, using the Admin SDK. That removed the whole
    // anti-wipe/size dance a public increment rule needed.
    match /Projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /Tags/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Settings Collection Handling
    match /Settings/Account {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /Settings/Canary {
      // PII-bearing doc: holds visitor names, emails, phone numbers, messages,
      // attachment URLs and live Meet links. Admin ONLY, for reads and writes.
      // Public booking availability is exposed via the sanitized Settings/BookedSlots
      // doc (Date + Time only), which a Cloud Function mirrors from Meetings here.
      //
      // Visitors used to update this doc directly under a rules-level rate limit.
      // Rules cannot check the one new entry inside a map, so any field, type or
      // length got through, and the cooldown timestamps were publicly writable (one
      // request could jam both forms). The contact form and bookings now go through
      // the submitContact / bookMeeting Cloud Functions, which validate and
      // rate-limit every submission and write here with the Admin SDK.
      allow read, write: if isAdmin();
    }

    // Treasury — private finances, split into documents:
    //   Treasury/projects   the projects I handle (with prices/earnings)
    //   Treasury/spendings  expenses
    //   Treasury/income     payments received
    //   Treasury/accounts   where money lives (bank/cash/wallet balances)
    //   Treasury/settings   currency + FX config
    // Admin read+write ONLY; never public. The homepage's sanitized list lives
    // separately in the public Settings/HandledProjects doc.
    match /Treasury/{docId} {
      allow read, write: if isAdmin();
    }

    // Spark (the dashboard AI) private memory — user's name, her editable
    // standing instructions, saved facts. Admin read+write ONLY.
    match /Spark/{docId} {
      allow read, write: if isAdmin();
    }

    // MCP server state — OAuth clients, auth codes, access/refresh tokens, pending
    // logins. Written ONLY by the Cloud Function via the Admin SDK (which bypasses
    // rules), so NO client may ever read or write it (tokens must never leak).
    match /MCP/{docId} {
      allow read, write: if false;
    }

    // Public-readable Settings content docs (Account bio, Availability,
    // HandledProjects, Developer, Tech Stack, BookedSlots, BookPage). Canary and MCP
    // stay private (rules are additive, so a blanket public read here would
    // re-grant access to them).
    //
    // Listed by name rather than "everything but Canary", so a doc added later (or
    // Settings/MCP, whose switches are nobody else's business) is private by default.
    match /Settings/{settingsDoc} {
      allow read: if settingsDoc in ['Account', 'Availability', 'BookedSlots', 'BookPage',
                                     'Developer', 'HandledProjects', 'Tech Stack'];
      allow write: if isAdmin();
    }

    // Any deeper Settings subcollection docs default to admin-only. Nothing public
    // lives under Settings any more - visit analytics moved to /Analytics below.
    match /Settings/{document=**} {
      allow read, write: if isAdmin();
    }

    // Visit analytics. Everything under here is written ONLY by the trackSession
    // Cloud Function through the Admin SDK, which bypasses these rules - so no
    // client, authenticated or not, may create or update a session, a daily rollup
    // or the lifetime totals. That is the fix for the old design, where visitors
    // wrote their own analytics and a rules-level rate limit silently ate them.
    match /Analytics/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Share links are the exception: the owner creates and edits them in the
    // dashboard. Their Opens/Sessions counters are still only raised by the function.
    match /Analytics/Links/Items/{linkId} {
      allow read, write: if isAdmin();
    }

    // A story can be thrown away, never forged or edited.
    match /Analytics/Sessions/Items/{sessionId} {
      allow read, delete: if isAdmin();
      allow create, update: if false;
    }

    // Rate-limit state for the public submission functions (hashed visitor IPs).
    // Written only by the Admin SDK; no client needs it.
    match /RateLimits/{docId} {
      allow read, write: if false;
    }

    // MCP audit log - one record per tool call, written only by the mcp function
    // (Admin SDK). The dashboard may read it and clear entries, but never create or
    // edit one, so the log cannot be forged from a browser.
    match /McpAudit/{entryId} {
      allow read, delete: if isAdmin();
    }

    // Secure everything else (require admin access).
    //
    // This CANNOT be a bare `match /{document=**}`. Firestore rules are additive -
    // an allow anywhere wins, and a deny never overrides one - so a recursive
    // catch-all silently re-granted the two collections that are explicitly denied
    // above: `/MCP/{docId}` (live OAuth access and refresh tokens, which must never
    // reach any client) and `/Analytics/Sessions/Items/{id}` (a visit story may be
    // deleted, never forged or edited). The same reasoning already excluded
    // Settings/Canary from the public Settings read.
    //
    // So the catch-all names the top-level collection in a single-segment variable
    // and subtracts those two, plus RateLimits and McpAudit (only functions write
    // them). Everything under them is governed only by their own
    // blocks above; the dashboard's real needs there (share links read/write, visit
    // stories read/delete) are granted explicitly and still work.
    match /{coll}/{doc} {
      allow read, write: if isAdmin() && !(coll in ['MCP', 'Analytics', 'RateLimits', 'McpAudit']);
    }
    match /{coll}/{doc}/{rest=**} {
      allow read, write: if isAdmin() && !(coll in ['MCP', 'Analytics', 'RateLimits', 'McpAudit']);
    }
  }
}