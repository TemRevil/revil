rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Function to check if the user is the admin
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'temrevil@gmail.com';
    }

    // Allow public read access to core portfolio data
    match /Projects/{document=**} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['Views'])
      );
    }
    
    match /Tags/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /Settings/Canary {
      allow read: if true;
      // Allow public update for contact form, but restrict other operations to admin
      allow write: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['Emails', 'Meetings'])
      );
    }

    match /Settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Secure everything else (require admin access)
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}