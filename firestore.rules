rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Function to check if the user is the admin (uses Firebase Custom Claims)
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Rate-limit helper: ensures at least `cooldownSecs` seconds have elapsed
    // since the document's last `lastWrite` server timestamp.
    // The client MUST include `lastWrite: serverTimestamp()` in every write.
    // Usage: isRateLimited(resource, request, 30) -> true if too soon
    function notRateLimited(cooldownSecs) {
      // New document: no prior timestamp - allow (first write)
      let lastWrite = resource == null
        ? request.time - duration.value(cooldownSecs + 1, 's')
        : resource.data.get('lastWrite', request.time - duration.value(cooldownSecs + 1, 's'));
      // Incoming write must declare lastWrite == request.time (server-verified)
      return request.resource.data.lastWrite == request.time
        && request.time >= lastWrite + duration.value(cooldownSecs, 's');
    }

    // Rate-limit helper for a named timestamp field (Canary uses separate fields)
    function notRateLimitedField(fieldName, cooldownSecs) {
      let lastWrite = resource == null
        ? request.time - duration.value(cooldownSecs + 1, 's')
        : resource.data.get(fieldName, request.time - duration.value(cooldownSecs + 1, 's'));
      return request.resource.data[fieldName] == request.time
        && request.time >= lastWrite + duration.value(cooldownSecs, 's');
    }

    // Allow public read access to core portfolio data
    match /Projects/{projectId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // Admin can update anything; public users can only increment Views sub-fields
      allow update: if isAdmin() || (
         // Only the 'Views' top-level key can change
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['Views'])
         // Views must remain a map
         && request.resource.data.Views is map
         // Anti-wipe: existing view sub-counters (Project/Github/Live/Download) must
         // all survive the write. A public caller can add/raise counters but never
         // drop them — blocks overwriting the whole map with {} to zero the counts.
         && request.resource.data.Views.keys().hasAll(resource.data.get('Views', {}).keys())
         // Bound document growth (Firestore per-doc cap is 1MB; a views map is tiny).
         // Stops a caller padding the doc with a huge map as a write-cost vector.
         && request.resource.size() < 64 * 1024
      );
    }
    
    match /Tags/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Settings Collection Handling
    match /Settings/Account {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Settings/Views parent document — read-only for public, admin-writable.
    // All public analytics writes go to subcollections (Analysis/, Links/, Socials/).
    match /Settings/Views {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /Settings/Canary {
      // PII-bearing doc: holds visitor names, emails, phone numbers, messages,
      // attachment URLs and live Meet links. Admin-read ONLY. Public booking
      // availability is exposed via the sanitized Settings/BookedSlots doc
      // (Date + Time only), which a Cloud Function mirrors from Meetings here.
      allow read: if isAdmin();
      // Admin has full write access
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        // Only allow modifications to Emails, Meetings, and their rate-limit timestamps
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['Emails', 'Meetings', 'lastEmailWrite', 'lastMeetingWrite'])
        // --- Email rate-limiting: max 2 per minute (30s cooldown) ---
        && (
          // If Emails didn't change, skip email rate-limit check
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['Emails'])
          || (
            request.resource.data.Emails.size() <= 50
            && notRateLimitedField('lastEmailWrite', 30)
            // Anti-wipe: every existing submission must survive the write. A public
            // caller can only ADD a new email entry, never shrink/replace the map —
            // blocks `updateDoc(Canary,{Emails:{}})` from erasing the whole inbox
            // (size()==0 would otherwise pass the <=50 cap).
            && request.resource.data.Emails.keys().hasAll(resource.data.get('Emails', {}).keys())
          )
        )
        // --- Meeting rate-limiting: max 1 per 5 minutes (300s cooldown) ---
        && (
          // If Meetings didn't change, skip meeting rate-limit check
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['Meetings'])
          || (
            request.resource.data.Meetings.size() <= 100
            && notRateLimitedField('lastMeetingWrite', 300)
            // Anti-wipe: existing bookings must survive (public callers only ADD).
            // Erasing Meetings would also clear the public BookedSlots mirror that a
            // Cloud Function derives from it, freeing genuinely-taken slots for
            // double-booking while the real Calendar events still exist.
            && request.resource.data.Meetings.keys().hasAll(resource.data.get('Meetings', {}).keys())
          )
        )
        // Ensure document doesn't grow unbounded (Firestore 1MB limit safety)
        && request.resource.size() < 500 * 1024
      );
    }

    // Settings/Views subcollections - analytics written by public visitors
    // Daily & Main analytics (Algorithm.tsx uses setDoc with merge)
    match /Settings/Views/Analysis/{docId} {
      allow read: if true;
      allow delete: if isAdmin();

      // Admin can always write
      allow create, update: if isAdmin();

      // Public create: allowed so setDoc(merge:true) works on first-ever write.
      // Restricted to the single known doc ID to prevent bots from spamming garbage
      // docs. (The legacy 'Main' aggregate doc was removed — all lifetime/today
      // totals are derived from the Daily series on read.)
      allow create: if
        docId == 'Daily'
        && request.resource.data.lastWrite == request.time
        && request.resource.size() < 64 * 1024;

      // Public update on Daily: dynamic date keys (e.g. "2026-05-04") can't
      // be enumerated in an allowlist, so we enforce rate-limit + size cap only.
      allow update: if docId == 'Daily' && (
        notRateLimited(5)
        && request.resource.size() < 64 * 1024
        // Ensure no keys are deleted to prevent wiping
        && request.resource.data.keys().hasAll(resource.data.keys())
        // Allow updating only lastWrite and at most one date key
        && request.resource.data.diff(resource.data).affectedKeys().size() <= 2
      );
    }

    // Link tracking (Algorithm.tsx increments Views + patches Rec_CLI)
    match /Settings/Views/Links/{linkId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // Public update: rate-limited to 1 write per 60s per link,
      // and only the Views counter or Rec_CLI string may change.
      allow update: if isAdmin() || (
        notRateLimited(60)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['Views', 'Rec_CLI', 'lastWrite'])
        // Views must only increase
        && (!('Views' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.Views >= resource.data.Views)
        // Rec_CLI must be a string if present
        && (!('Rec_CLI' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.Rec_CLI is string)
        && request.resource.size() < 100 * 1024
      );
    }

    // Social click tracking (useSocialTracker.ts uses setDoc merge + updateDoc)
    match /Settings/Views/Socials/{socialName} {
      allow read: if true;
      allow delete: if isAdmin();
      // Admin can always write
      allow create, update: if isAdmin();
      // Public create: first click on a new social link.
      // socialName is constrained to safe chars + length so bots can't spam garbage / Unicode bombs.
      allow create: if
        socialName.matches('^[a-zA-Z0-9_-]{1,40}$')
        && request.resource.data.lastWrite == request.time
        && request.resource.size() < 100 * 1024;
      // Public update: rate-limited to 1 write per 30s per social document,
      // document capped at 100KB to prevent unbounded growth.
      allow update: if (
        notRateLimited(30)
        && request.resource.size() < 100 * 1024
        // Ensure no keys are deleted to prevent wiping
        && request.resource.data.keys().hasAll(resource.data.keys())
        // Allow updating only lastWrite and at most one click key
        && request.resource.data.diff(resource.data).affectedKeys().size() <= 2
      );
    }

    // Treasury — private finances, split into documents:
    //   Treasury/projects   the projects I handle (with prices/earnings)
    //   Treasury/spendings  expenses
    //   Treasury/income     payments received
    //   Treasury/accounts   where money lives (bank/cash/wallet balances)
    //   Treasury/settings   currency + FX config
    // Admin read+write ONLY; never public. The homepage's sanitized list lives
    // separately in the public Settings/HandledProjects doc.
    match /Treasury/{docId} {
      allow read, write: if isAdmin();
    }

    // Spark (the dashboard AI) private memory — user's name, her editable
    // standing instructions, saved facts. Admin read+write ONLY.
    match /Spark/{docId} {
      allow read, write: if isAdmin();
    }

    // MCP server state — OAuth clients, auth codes, access/refresh tokens, pending
    // logins. Written ONLY by the Cloud Function via the Admin SDK (which bypasses
    // rules), so NO client may ever read or write it (tokens must never leak).
    match /MCP/{docId} {
      allow read, write: if false;
    }

    // Public-readable Settings content docs (Account bio, Availability,
    // HandledProjects, Developer, Tech Stack, BookedSlots, etc.). Canary is the
    // one private exception (its admin-only block is above; rules are additive, so
    // it must be excluded here or a blanket public read would re-grant access).
    match /Settings/{settingsDoc} {
      allow read: if settingsDoc != 'Canary';
      allow write: if isAdmin();
    }

    // Any deeper Settings subcollection docs without an explicit rule default to
    // admin-only (the named analytics subcollections above grant their own public read).
    match /Settings/{document=**} {
      allow read, write: if isAdmin();
    }

    // Secure everything else (require admin access)
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}