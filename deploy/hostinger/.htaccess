RewriteEngine On

# One host: www.temrevil.com answered with the same pages, a duplicate copy of the
# site for search engines. Send it to the apex with a permanent redirect.
RewriteCond %{HTTP_HOST} ^www\.temrevil\.com$ [NC]
RewriteRule ^ https://temrevil.com%{REQUEST_URI} [R=301,L]

# Map extensionless routes to their exported `.html` file. The static export emits
# pages as `mcp-login.html` (not `mcp-login/index.html`), but a bare `/mcp-login`
# request gets a 301 to `/mcp-login/`, which the host then serves as a directory →
# 403 Forbidden. Rewrite to the real file first (with or without a trailing slash)
# so these routes resolve to a 200 instead of the directory trap.
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# Serve real files directly.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# A share link is temrevil.com/<code>, one segment shaped like a link code (the same
# rule the recorder and trackSession use). It gets share.html, the app shell marked
# noindex (scripts/share-shell.mjs), which reads the code. Only the server knows which
# codes exist, so an unknown code still opens the site, unindexed.
RewriteRule ^[A-Za-z0-9_-]{4,32}/?$ share.html [L]

# Every other address is a real 404, with the site's own 404 page.
ErrorDocument 404 /404.html
RewriteRule ^ - [R=404,L]

# ── Security headers (delivered as real HTTP headers, not <meta>) ──
# frame-ancestors / X-Frame-Options must be HTTP headers to take effect —
# browsers ignore frame-ancestors when set via a <meta> tag.
<IfModule mod_headers.c>
  # Content Security Policy, the whole policy as a real header (a <meta> one can't
  # carry frame-ancestors). frame-ancestors 'none' blocks framing (clickjacking);
  # X-Frame-Options below is the fallback for browsers without it.
  # scripts/csp-headers.mjs rewrites this block at deploy: it hashes each page's inline
  # scripts and swaps 'unsafe-inline' in script-src for exactly those hashes, per page.
  # connect-src is every host the code calls: Firebase (Firestore, Storage, Auth,
  # App Check, Functions), reCAPTCHA, the MCP server, GitHub data, exchange rates,
  # Unsplash (the default hero image), and the LLM providers the dashboard's
  # override key calls directly (src/lib/llm.ts).
  # CSP:BEGIN
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://apis.google.com https://www.gstatic.com https://www.google.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https://*.googleapis.com https://*.googleusercontent.com https://www.gstatic.com https://images.unsplash.com https://avatars.githubusercontent.com; media-src 'self' https://firebasestorage.googleapis.com https://*.firebasestorage.app; connect-src 'self' https://firestore.googleapis.com https://firebasestorage.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://content-firebaseappcheck.googleapis.com https://us-central1-temrevil1.cloudfunctions.net https://www.google.com https://mcp.temrevil.com https://api.github.com https://github-contributions-api.jogruber.de https://open.er-api.com https://images.unsplash.com https://generativelanguage.googleapis.com https://api.anthropic.com https://api.openai.com; frame-src https://accounts.google.com https://*.firebaseapp.com https://www.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
  # CSP:END
  Header always set X-Frame-Options "DENY"

  # Don't leak full referrer URLs to third parties.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Stop browsers from MIME-sniffing a response away from the declared content-type.
  Header always set X-Content-Type-Options "nosniff"

  # Force HTTPS for two years incl. subdomains; opt into browser preload lists.
  # Defends an admin-dashboard site against SSL-strip / protocol-downgrade attacks.
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
</IfModule>

# ── MIME types ──
<IfModule mod_mime.c>
  # Serve the PWA manifest with the correct type (Apache defaults it to text/plain,
  # which some browsers reject for <link rel="manifest">).
  AddType application/manifest+json .webmanifest
</IfModule>

# ── Compression (smaller payloads -> faster load -> better Core Web Vitals/SEO) ──
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/manifest+json
  AddOutputFilterByType DEFLATE application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml font/ttf font/otf font/woff font/woff2
</IfModule>

# ── Caching strategy ──
# Only content-hashed assets get the 1-year immutable cache. Code/fonts (js, css,
# woff2…) live under /_next/ with a content hash in the filename, so a year is safe.
# Images are NOT hashed in a static export — the PWA icons (icon-192/512.webp) are
# copied verbatim from public/ under stable names, so an immutable year would pin a
# stale icon for returning visitors after a re-encode. Give images a short TTL, and
# keep the app shell + SEO/manifest files always-fresh.
<IfModule mod_headers.c>
  # Immutable, content-hashed code + fonts from the Next.js export (/_next/static).
  <FilesMatch "\.(js|css|woff2|woff|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Non-hashed images (stable filenames) — short cache so replacements propagate.
  <FilesMatch "\.(webp|png|jpg|jpeg|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # Always-fresh: app shell + SEO/crawler + manifest files (no version hash).
  <FilesMatch "\.(html|xml|txt|json|webmanifest)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
