RewriteEngine On

# Serve real files directly and fall back to the exported app shell.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^ index.html [L]

# ── Security headers (delivered as real HTTP headers, not <meta>) ──
# frame-ancestors / X-Frame-Options must be HTTP headers to take effect —
# browsers ignore frame-ancestors when set via a <meta> tag.
<IfModule mod_headers.c>
  # Block this site from being embedded in any <iframe> (clickjacking defense).
  # 'none' = no site may frame us. X-Frame-Options is the legacy fallback for
  # older browsers that don't support CSP frame-ancestors.
  Header always set Content-Security-Policy "frame-ancestors 'none';"
  Header always set X-Frame-Options "DENY"

  # Don't leak full referrer URLs to third parties.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Stop browsers from MIME-sniffing a response away from the declared content-type.
  Header always set X-Content-Type-Options "nosniff"

  # Force HTTPS for two years incl. subdomains; opt into browser preload lists.
  # Defends an admin-dashboard site against SSL-strip / protocol-downgrade attacks.
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
</IfModule>

# ── MIME types ──
<IfModule mod_mime.c>
  # Serve the PWA manifest with the correct type (Apache defaults it to text/plain,
  # which some browsers reject for <link rel="manifest">).
  AddType application/manifest+json .webmanifest
</IfModule>

# ── Compression (smaller payloads -> faster load -> better Core Web Vitals/SEO) ──
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/manifest+json
  AddOutputFilterByType DEFLATE application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml font/ttf font/otf font/woff font/woff2
</IfModule>

# ── Caching strategy ──
# Only content-hashed assets get the 1-year immutable cache. Code/fonts (js, css,
# woff2…) live under /_next/ with a content hash in the filename, so a year is safe.
# Images are NOT hashed in a static export — the PWA icons (icon-192/512.webp) are
# copied verbatim from public/ under stable names, so an immutable year would pin a
# stale icon for returning visitors after a re-encode. Give images a short TTL, and
# keep the app shell + SEO/manifest files always-fresh.
<IfModule mod_headers.c>
  # Immutable, content-hashed code + fonts from the Next.js export (/_next/static).
  <FilesMatch "\.(js|css|woff2|woff|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Non-hashed images (stable filenames) — short cache so replacements propagate.
  <FilesMatch "\.(webp|png|jpg|jpeg|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # Always-fresh: app shell + SEO/crawler + manifest files (no version hash).
  <FilesMatch "\.(html|xml|txt|json|webmanifest)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
