# ---------------------------------------------------------------------------
# Copy to `.env.local` and fill in with your own Firebase project's values.
#
# Everything here is NEXT_PUBLIC_*, which means it is bundled into the client
# and visible to anyone who opens devtools. That is expected: a Firebase web
# config is an identifier, not a credential. The app is protected by Firebase
# App Check + Firestore/Storage security rules, not by hiding these values.
#
# Real secrets NEVER live in this file. See "Secrets" at the bottom.
# ---------------------------------------------------------------------------

# Firebase web app config - Project settings > General > Your apps > SDK setup
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSy..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="000000000000"
NEXT_PUBLIC_FIREBASE_APP_ID="1:000000000000:web:abc123"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# App Check debug token (LOCAL DEV ONLY - never set this in production).
# App Check is enforced, so localhost is blocked until you register a debug
# token: run the app, copy the token the console prints, then add it under
# Firebase Console > App Check > Apps > Manage debug tokens.
NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=""

# Optional: only used by the dashboard assistant when you want to call an LLM
# directly from the client. Leave EMPTY to route through the `llm` Cloud
# Function instead, which keeps the provider key server-side (recommended).
NEXT_PUBLIC_LLM_API_KEY=""

# ---------------------------------------------------------------------------
# Secrets (NOT in this file, NOT in any .env)
# ---------------------------------------------------------------------------
# The Cloud Functions read these from Google Secret Manager. They are never
# committed and never reach the browser. Set each one with:
#
#   firebase functions:secrets:set <NAME>
#
#   SMTP_USER          Owner's inbox - receives notifications, BCC'd on receipts
#   RESEND_API_KEY     Resend SMTP relay password (transactional email)
#   LLM_API_KEY        Provider key for the `llm` proxy (Anthropic/OpenAI/Gemini)
#   MEETING_SYNC_URL   Google Apps Script web-app URL that owns the Google
#                      Calendar event + Meet link. Treat it as a credential:
#                      anyone holding this URL can create, move or cancel
#                      events on the owner's calendar.
