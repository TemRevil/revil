    "brace-expansion@1.1.12": "1.1.13",
    "flatted@3.3.3": "3.4.2",
    "lodash@4.17.23": "4.18.1",
    "protobufjs": "^7.5.8"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "country-flag-emoji-polyfill": "^0.1.10",
