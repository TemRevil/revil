{
  "name": "revil",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/public-data.mjs && node scripts/share-shell.mjs",
    "start": "node scripts/preview.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-revil \"vitest run --config vitest.rules.config.mjs\"",
