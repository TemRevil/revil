rules_version = '2';

// Craft rules for Firebase Storage
// See https://firebase.google.com/docs/storage/security
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Contact form email attachments — public write with strict constraints.
    // Object-level read stays public so the uploader's getDownloadURL() (called
    // right after upload to store the link) works and the admin's notification
    // email links resolve. Enumeration is blocked at the bucket root below
    // (admin-only read on the {allPaths=**} catch-all), and folder IDs are
    // unguessable random strings, so attachments can't be discovered or listed.
    // Note: SVG is intentionally NOT in the allowlist — SVGs can execute JS when
    // served as image/svg+xml. Allowed: raster images, PDF, plain text, MS Office.
    match /emails/{emailId}/{fileName} {
      allow read: if true;
      allow write: if
        // Max 10MB per file
        request.resource.size < 10 * 1024 * 1024
        // Only allow safe, non-executable file types
        && (
          request.resource.contentType.matches('image/(png|jpe?g|gif|webp|bmp).*')
          || request.resource.contentType == 'application/pdf'
          || request.resource.contentType == 'text/plain'
          || request.resource.contentType == 'application/msword'
          || request.resource.contentType.matches('application/vnd\\.openxmlformats.*')
        );
    }

    // Everything else — admin-only read AND write.
    // Read is admin-only to stop anonymous listAll(ref(storage, '')) from
    // enumerating the bucket (e.g. discovering every emails/<id>/ folder).
    // Public-facing assets (hero/profile images) are loaded via tokenized
    // getDownloadURL() links, which bypass these rules, so locking read here
    // does not break image display.
    match /{allPaths=**} {
      allow read: if isAdmin();

      // Admin-only write via custom claim (`admin: true`)
      // Set this once: admin.auth().setCustomUserClaims(uid, { admin: true })
      // Using a claim instead of hardcoded email so admin can change without re-deploying rules.
      allow write: if isAdmin()
        && request.resource.size < 50 * 1024 * 1024;
    }
  }
}
