rules_version = '2';

// Craft rules for Firebase Storage
// See https://firebase.google.com/docs/storage/security
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Contact form email attachments - public upload with strict constraints.
    // `get` stays public so the uploader's getDownloadURL() (called right after
    // upload to store the link) works and the admin's notification email links
    // resolve. It is `get`, not `read`: `read` also grants `list`, which let anyone
    // who knew one folder ID list every file in it. Folder IDs are unguessable
    // random strings, so attachments can't be discovered.
    // Note: SVG is intentionally NOT in the allowlist - SVGs can execute JS when
    // served as image/svg+xml. Allowed: raster images, PDF, plain text, MS Office.
    // The content-type pattern is exact: the old ones ended in `.*`, so a value
    // such as "image/png, text/html" matched too.
    // `resource == null`: in Storage rules, uploading over an existing file also
    // counts as `create`, so without it anyone who knew an attachment's path could
    // replace it with a different file after the owner had looked at it.
    // Storage rules cannot count uploads; the cleanupAttachments function deletes
    // any upload that no message points to once it is a day old.
    // Deleting an attachment is the cleanup function's job - it uses the Admin SDK,
    // which bypasses these rules.
    match /emails/{emailId}/{fileName} {
      allow get: if true;
      allow create: if resource == null
        && emailId.size() <= 40
        && fileName.size() <= 200
        // Max 10MB per file
        && request.resource.size < 10 * 1024 * 1024
        // Only allow safe, non-executable file types
        && request.resource.contentType.matches(
          '^(image/(png|jpe?g|gif|webp|bmp)|application/pdf|text/plain|application/msword|application/vnd[.]openxmlformats-officedocument[.](wordprocessingml[.]document|spreadsheetml[.]sheet|presentationml[.]presentation))$'
        );
    }

    // Everything else — admin-only read AND write.
    // Read is admin-only to stop anonymous listAll(ref(storage, '')) from
    // enumerating the bucket (e.g. discovering every emails/<id>/ folder).
    // Public-facing assets (hero/profile images) are loaded via tokenized
    // getDownloadURL() links, which bypass these rules, so locking read here
    // does not break image display.
    match /{allPaths=**} {
      allow read: if isAdmin();

      // Admin-only write via custom claim (`admin: true`)
      // Set this once: admin.auth().setCustomUserClaims(uid, { admin: true })
      // Using a claim instead of hardcoded email so admin can change without re-deploying rules.
      allow write: if isAdmin()
        && request.resource.size < 50 * 1024 * 1024;
    }
  }
}
