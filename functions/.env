# Public base URL of the MCP server (advertised in OAuth metadata). Served at the
# vanity domain via a Firebase Hosting site that rewrites all paths to the `mcp`
# Cloud Run service; the raw cloudfunctions.net/mcp URL still works as a fallback.
MCP_BASE_URL=https://mcp.temrevil.com

# Portfolio origin hosting the /mcp-login Google sign-in bridge page.
MCP_SITE_URL=https://temrevil.com
